# --- Database ---
POSTGRES_USER=startend
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=startend
DATABASE_URL=postgresql+asyncpg://startend:CHANGE_ME_TO_A_STRONG_PASSWORD@db:5432/startend

# --- WhatsApp ---
# Adapter: "mock" (no real messages) or "meta" (live WhatsApp via Meta Cloud API)
WHATSAPP_ADAPTER=mock

# Required only when WHATSAPP_ADAPTER=meta
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=

# --- Contact form email notifications ---
# Sent via SMTP over SSL. Leave empty to disable (form still works and stores).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
CONTACT_TO=

# --- Public URL (Stripe success/cancel + Google OAuth redirect) ---
# Production: https://www.startend.ch
PUBLIC_BASE_URL=
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# Set true behind HTTPS in production
SESSION_HTTPS_ONLY=false

# --- X Autopilot Stripe Checkout ---
STRIPE_SECRET_KEY=
# Signing secret of the one endpoint both ventures share: POST /stripe/webhook
# (the older /apps/stripe/webhook and /x-autopilot/stripe/webhook use it too).
STRIPE_WEBHOOK_SECRET=
# List price is CHF 14900. For the CHF 1 smoke test set 100, then refund.
STRIPE_XAUTOPILOT_AMOUNT_CENTS=14900
# payment (default, one-time) or subscription
STRIPE_XAUTOPILOT_MODE=payment
# Optional Stripe Price id; when set, amount/mode above are ignored for line items
STRIPE_XAUTOPILOT_PRICE_ID=

# --- /x-autopilot tiers (CHF 149 / 330 / 990) ---
# One recurring monthly Stripe Price id per tier, created in the dashboard.
# Unset => that tier's button renders disabled with data-missing-env, never a
# broken link. Buttons point at /x-autopilot/checkout/{149,330,990}.
PRICE_ID_XA_149=
PRICE_ID_XA_330=
PRICE_ID_XA_990=
# subscription (default, recurring Prices) or payment (one-time Prices)
STRIPE_XA_TIER_MODE=subscription
# n8n webhook that appends rows to the xautopilot_orders data table.
# Fed by the shared Stripe endpoint: {PUBLIC_BASE_URL}/stripe/webhook
N8N_XAUTOPILOT_ORDER_URL=
# X (Twitter) OAuth consent link shown on /x-autopilot/success.
# Empty falls back to the on-site form at /x-autopilot/onboarding.html
X_OAUTH_ONBOARDING_URL=

# --- /apps WhatsApp reservation setup (one Checkout Session, two prices) ---
# Stripe Price ids created in the dashboard:
#   PRICE_ID_APPS_SETUP   one-time, CHF 1990
#   PRICE_ID_APPS_MONTHLY recurring monthly, CHF 249
PRICE_ID_APPS_SETUP=
PRICE_ID_APPS_MONTHLY=
# n8n webhook that appends rows to the apps_orders data table.
# Fed by the shared Stripe endpoint: {PUBLIC_BASE_URL}/stripe/webhook
N8N_APPS_ORDER_URL=

# --- Google Sign-In (customers) + Sheets (env-only refresh token) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Redirect URIs to register:
#   {PUBLIC_BASE_URL}/x-autopilot/auth/google/callback
GOOGLE_SHEETS_REFRESH_TOKEN=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_RANGE=Sheet1!A1:D20
# Operator reconnect: GET /x-autopilot/sheets/reconnect?key=...
GOOGLE_SHEETS_RECONNECT_KEY=

# HQ Mail Lane — n8n webhook that emails Marcin the Sheets reconnect link
# whenever GOOGLE_SHEETS_REFRESH_TOKEN is missing/invalid. POST {subject, body}.
HQ_MAIL_WEBHOOK_URL=
