# Environment for the CI stranger test. Every outbound URL points back at the
# app's own /_stub router, so nothing leaves the runner and no real key exists.
# None of these values is a secret. Never set ZORBECK_STUB on Railway.
ZORBECK_STUB=1
PUBLIC_BASE_URL=http://127.0.0.1:8765
STRIPE_API_BASE=http://127.0.0.1:8765/_stub/v1
STRIPE_SECRET_KEY=stub-key-not-a-secret
STRIPE_WEBHOOK_SECRET=stub-webhook-signing-key-not-a-secret
HQ_MAIL_WEBHOOK_URL=http://127.0.0.1:8765/_stub/mail
ALERT_WEBHOOK_URL=http://127.0.0.1:8765/_stub/alerts
SIGNUP_WEBHOOK_URL=http://127.0.0.1:8765/_stub/leads
ZORBECK_PRICE_CENTS=100
